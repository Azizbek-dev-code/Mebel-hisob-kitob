# ---------------------------------------------------------------------------
# Furniture ERP - example environment file
#
# Copy this file to `server/.env` (the API reads it, and Prisma reads it too).
# Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
# Local:  postgresql://postgres:postgres@localhost:5432/furniture_erp?schema=public
# Neon:   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/furniture_erp?schema=public"

# --- Authentication ----------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET="change-me-cookie-secret"
# Set to true when serving over HTTPS in production
COOKIE_SECURE=false
# lax = same-site SPA/API (Vite proxy or Vercel /api rewrites). none = cross-origin
# SPA→API (Vercel→Render without rewrites); requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# --- File storage ------------------------------------------------------------
# Storage driver: local | cloudinary | supabase
# Local development: keep STORAGE_DRIVER=local so product images land under
# STORAGE_LOCAL_DIR and are served at STORAGE_PUBLIC_URL (see docs/LOCAL_TEST.md).
# Production rejects local — use cloudinary (see docs/PRODUCTION.md).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:4000/uploads

# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=

# --- Backups -------------------------------------------------------------------
# Where generated backup archives are written before the administrator downloads
# them. Scratch space, not durable storage: on a host with an ephemeral
# filesystem the files disappear on restart while the catalogue rows survive.
BACKUP_DIR=./backups
# Largest restore upload accepted, in bytes (50 MB).
BACKUP_MAX_UPLOAD_BYTES=52428800
# Full-database pg_dump export. Requires the pg_dump binary on PATH.
BACKUP_ENABLE_PG_DUMP=false

# --- Seed account (development only) ------------------------------------------
SEED_ADMIN_EMAIL=admin@furniture-erp.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_STORE_NAME="Mebel Savdo"
SEED_PLATFORM_ADMIN_EMAIL=platform@furniture-erp.local
SEED_PLATFORM_ADMIN_PASSWORD=Platform123!
# Demo subscription catalog (so'm / month). Change these to match business prices.
SEED_PLAN_START_PRICE=150000
SEED_PLAN_PRO_PRICE=200000
SEED_PLAN_BUSINESS_PRICE=350000
SEED_DEFAULT_PLAN_NAME=START
# Trial length when a store is approved (days). Uses server/DB clock.
TRIAL_DAYS=7

# --- Client (client/.env) ------------------------------------------------------
# Prefer /api (same origin via proxy/rewrites). Absolute URL needs COOKIE_SAME_SITE=none.
# VITE_API_URL=/api
VITE_API_URL=http://localhost:4000/api
