# Copy to `server/.env`. Both the API and the Prisma CLI read this file.
# See the repository root `.env.example` for the annotated reference.

NODE_ENV=development
PORT=4000

# Local Postgres (create the DB first). Annotated notes: repo root `.env.example`
# and docs/LOCAL_TEST.md.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/furniture_erp?schema=public"

JWT_ACCESS_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string-32-chars"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET="change-me-cookie-secret"
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

CORS_ORIGIN=http://localhost:5173

STORAGE_DRIVER=local
# Local images: files under STORAGE_LOCAL_DIR, publicly at STORAGE_PUBLIC_URL.
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:4000/uploads

# Backups. BACKUP_DIR holds generated archives until they are downloaded; treat
# it as scratch space, not durable storage. pg_dump support stays off unless the
# binary is on PATH and you explicitly enable it.
BACKUP_DIR=./backups
BACKUP_MAX_UPLOAD_BYTES=52428800
BACKUP_ENABLE_PG_DUMP=false

SEED_ADMIN_EMAIL=admin@furniture-erp.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_STORE_NAME="Mebel Savdo"
SEED_PLATFORM_ADMIN_EMAIL=platform@furniture-erp.local
SEED_PLATFORM_ADMIN_PASSWORD=Platform123!
SEED_PLAN_START_PRICE=150000
SEED_PLAN_PRO_PRICE=200000
SEED_PLAN_BUSINESS_PRICE=350000
SEED_DEFAULT_PLAN_NAME=START
TRIAL_DAYS=7
