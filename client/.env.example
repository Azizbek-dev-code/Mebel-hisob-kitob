# Copy to `client/.env` only if you need to override the defaults.
#
# By default the Vite dev server proxies `/api` to http://localhost:4000, which
# keeps the browser on a single origin so the HTTP-only auth cookie works.

# Prefer /api (Vite proxy in dev; Vercel rewrites in prod) so auth cookies stay same-site.
# VITE_API_URL=/api
# VITE_PROXY_TARGET=http://localhost:4000
#
# Cross-origin production only (also set COOKIE_SAME_SITE=none + COOKIE_SECURE=true on API):
# VITE_API_URL=https://YOUR_API.onrender.com/api
